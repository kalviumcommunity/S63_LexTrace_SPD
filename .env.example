# ==============================================================================
# ChronoLex Environment Variables Template
# Copy this file to .env before starting the services
# ==============================================================================

# API Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# OpenAI-Compatible LLM API Configuration
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Embeddings API Configuration
EMBEDDING_MODEL=text-embedding-3-small

# Vector Database Configuration (Planned: ChromaDB / Qdrant)
VECTOR_DB_URL=http://localhost:8000
VECTOR_DB_COLLECTION=chronolex_regulations

# Frontend Configuration (for apps/web)
NEXT_PUBLIC_API_URL=http://localhost:8000
